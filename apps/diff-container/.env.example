# apps/diff-container environment (specification/03-configuration.md §3). Validated by `containerEnv` in @vrt/shared.

# Cloudflare account id (R2 S3 endpoint host)
CF_ACCOUNT_ID=
# R2 S3 API token (Object Read & Write, all buckets)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bearer token the worker sends to POST /diff (32+ characters)
DIFF_CONTAINER_SHARED_SECRET=
# HTTP port (default 8080)
PORT=8080
