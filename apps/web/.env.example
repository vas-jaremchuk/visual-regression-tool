# apps/web environment (specification/03-configuration.md §2). Validated by `webEnv` in @vrt/shared.

# App: absolute URL used in emails and share links
APP_URL=http://localhost:3000

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key: server only (invitations, share links)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare account id
CF_ACCOUNT_ID=
# Cloudflare API token: Account > Workers R2 Storage: Edit (bucket list/create, usage)
CF_API_TOKEN=
# R2 S3 API token (Object Read & Write, all buckets)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Worker base URL
WORKER_URL=http://localhost:8787
# HMAC key for web -> worker calls (32+ random bytes, base64): openssl rand -base64 32
WORKER_SHARED_SECRET=

# AES-256-GCM key(s) for secrets at rest: comma-separated base64 32-byte keys, first one encrypts
SETTINGS_ENCRYPTION_KEY=

# Resend API key
RESEND_API_KEY=
# Sender address for emails
EMAIL_FROM="Visual Regression <vrt@example.com>"

# Show "Continue with Google" on /login (enable the provider in Supabase Auth first)
GOOGLE_AUTH_ENABLED=false
