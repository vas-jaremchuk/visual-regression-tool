# Staging release acceptance suite (specification/11-testing.md §4). Validated by `stagingEnv` in @vrt/shared.
# Staging values only, never production. Set as GitHub Actions secrets of the `staging` environment.

# Deployed staging web app
STAGING_APP_URL=https://vrt-staging.example.com
# Staging Supabase project URL and service role key (test users, sign-in links, outcome checks)
STAGING_SUPABASE_URL=https://staging-project.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Deployed fixture site Worker (apps/worker/wrangler.fixture-site.jsonc)
STAGING_FIXTURE_SITE_URL=https://vrt-fixture-site.example.workers.dev
# Platform admin of staging (`pnpm seed:admin`); editor and viewer get +vrt-editor / +vrt-viewer aliases
STAGING_ADMIN_EMAIL=
# Slack incoming webhook of a test channel for notification delivery
STAGING_SLACK_WEBHOOK_URL=
# Prototype .env of a real legacy bucket set (step 8); small sitemap recommended
STAGING_LEGACY_ENV=
