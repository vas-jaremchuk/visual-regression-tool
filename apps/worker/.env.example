# apps/worker environment (specification/03-configuration.md §3). Validated by `workerEnv` in @vrt/shared.
# Set as wrangler secrets/vars in deployed environments; copy to .dev.vars for `wrangler dev`.

# Supabase project URL and service role key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare account id and API token (R2 bucket admin)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# R2 S3 API token (Object Read & Write, all buckets)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# HMAC key shared with apps/web (32+ random bytes, base64)
WORKER_SHARED_SECRET=
# AES-256-GCM key(s): comma-separated base64 32-byte keys, first one encrypts
SETTINGS_ENCRYPTION_KEY=
# Resend API key and sender address
RESEND_API_KEY=
EMAIL_FROM="Visual Regression <vrt@example.com>"
# Web app URL used in notification links
APP_URL=http://localhost:3000
# Bearer token for worker -> diff container calls (32+ characters)
DIFF_CONTAINER_SHARED_SECRET=
