{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-regression-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Binding names are part of the contract (specification/03-configuration.md §3).
  // Secrets (03 §3 dotenv block) are set with `wrangler secret put` / `.dev.vars`, never here.
  "browser": {
    "binding": "BROWSER",
  },
  "workflows": [
    { "binding": "CAPTURE_RUN", "name": "vrt-capture-run", "class_name": "CaptureRunWorkflow" },
    { "binding": "COMPARE_RUN", "name": "vrt-compare-run", "class_name": "CompareWorkflow" },
    { "binding": "SITEMAP_FETCH", "name": "vrt-sitemap-fetch", "class_name": "SitemapWorkflow" },
  ],
  "queues": {
    "producers": [
      { "binding": "CAPTURE_QUEUE", "queue": "vrt-capture" },
      { "binding": "DIFF_QUEUE", "queue": "vrt-diff" },
    ],
    // Batch sizes and retries mirror CAPTURE_BATCH_SIZE / DIFF_BATCH_SIZE in @vrt/shared (see LIMITS.md).
    "consumers": [
      {
        "queue": "vrt-capture",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "vrt-capture-dlq",
      },
      {
        "queue": "vrt-diff",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "vrt-diff-dlq",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIFF_CONTAINER", "class_name": "DiffContainer" },
      // Per-project + global Browser Rendering semaphore (06 §2).
      { "name": "PROJECT_LIMITER", "class_name": "ProjectLimiter" },
    ],
  },
  "containers": [
    {
      "class_name": "DiffContainer",
      "image": "../diff-container/Dockerfile",
      "image_build_context": "../diff-container",
      // ≥ 1 GiB RAM (ADR-2): standard-1 = 1/2 vCPU, 4 GiB
      "instance_type": "standard-1",
      "max_instances": 5,
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiffContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["ProjectLimiter"] },
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "dev": {
    // Building the container image needs Docker; `pnpm dev` runs without it.
    // Set to true (or pass --enable-containers) to run the diff container locally.
    "enable_containers": false,
  },
}
