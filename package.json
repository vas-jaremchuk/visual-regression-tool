{
  "name": "visual-regression-tool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web --filter=worker",
    "lint": "eslint . && pnpm --filter web lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "db:start": "echo \"db:start: not yet configured (T02)\"",
    "db:reset": "echo \"db:reset: not yet configured (T02)\"",
    "db:types": "echo \"db:types: not yet configured (T02)\"",
    "test:db": "echo \"test:db: not yet configured (T02)\"",
    "test:e2e": "echo \"test:e2e: not yet configured\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
