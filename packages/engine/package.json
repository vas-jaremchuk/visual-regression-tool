{
  "name": "@vrt/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, runtime-agnostic visual regression logic (no I/O).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./diff": "./src/diff.ts",
    "./ignore-rules": "./src/ignore-rules.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='src/**/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/test/**' --coverage.thresholds.lines=90"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@vrt/shared": "workspace:*",
    "pixelmatch": "5.3.0",
    "pngjs": "^7.0.0"
  }
}
